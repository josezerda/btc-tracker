{
  "name": "btc-tracker",
  "version": "1.0.0",
  "description": "Pagina web que muestra la cotizacion de Bitcoin (BTC) en tiempo real. Proyecto 1 - CI/CD con GitHub Actions + Terraform + Docker.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest --coverage",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file sbom/sbom-npm.cdx.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
